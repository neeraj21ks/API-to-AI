# Local PostgreSQL (Docker Compose)
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_PORT=5432

# Application connection string
DATABASE_URL=postgresql://nexus:change-me-to-a-long-random-password@localhost:5432/nexus

# Binance public market-data API (no API key required for public klines)
BINANCE_BASE_URL=https://api.binance.com
